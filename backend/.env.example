# Backend environment (copy to .env and fill in real values). Placeholders only.

# App
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-service-role-key

# LLM (Anthropic via langchain-anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings (Voyage AI by MongoDB)
# Create the key in the MongoDB Atlas UI: your project -> AI Model APIs ->
# "Create model API key". No MongoDB database, Atlas CLI, or mongosh is needed.
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-4-lite

# LangSmith (keep tracing disabled by default)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=similia-ai
LANGSMITH_TRACING=false

# Embedding budget persists across checkpoint resumes.
MAX_RUN_EMBEDDING_TOKENS=200000

# Production (see docs/production-runbook.md)
ENVIRONMENT=development
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_PREVIOUS=
AI_QUESTIONS_PER_HOUR=30
AI_ANALYSES_PER_HOUR=10
AI_QUESTIONS_PER_DAY=150
AI_ANALYSES_PER_DAY=40
AI_ANALYSES_PER_MONTH=600
EMBEDDING_BUDGET_TOKENS=500000
RAG_MIN_SIMILARITY=0.25
